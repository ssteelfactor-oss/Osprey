# ─────────────────────────────────────────────────────────────────────────────
# Osprey — .gitignore
# Native C (MSVC / Visual Studio). No managed runtime, no package managers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Build output directories ────────────────────────────────────────────────
[Dd]ebug/
[Rr]elease/
[Dd]ebug[Pp]ublic/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Bb]in/
[Oo]bj/
[Bb]uild/
[Oo]ut/

# ── Compiler / linker intermediates & artifacts ─────────────────────────────
*.obj
*.o
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.pch
*.ipch
*.res
*.tlog
*.recipe
*.lastbuildstate
*.unsuccessfulbuild
*.log
*.vsidx
*.db

# ── Visual Studio IDE / cache / per-user files ──────────────────────────────
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.VC.opendb
*.aps
*.ncb
ipch/
*.cachefile
vcpkg.applocal.log

# ── CMake (only if you ever add it) ─────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake-build-*/

# ── Editors ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── OS junk ─────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ── Scan output — NEVER commit ──────────────────────────────────────────────
# Osprey sweeps a real subnet: reachable endpoint mappers, registered DCOM
# interfaces, activation ACLs, RunAs identities, host-leaked addresses. That is
# a live recon map of an internal network — exactly what must not land in a
# public repo. Keep any generated output in a dedicated, ignored folder.
reports/
out/
*.report.html
*.report.json
*.report.yaml
