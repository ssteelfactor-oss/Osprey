# Match each file's tracked EOL to how it actually lives on disk, so git never
# has to convert on checkout and never warns on add/commit.
* text=auto

# Hand-written / generated sources live as LF
*.c            text eol=lf
*.h            text eol=lf
*.md           text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Visual Studio project files and batch scripts are CRLF on disk
*.bat          text eol=crlf
*.sln          text eol=crlf
*.vcxproj      text eol=crlf
*.filters      text eol=crlf
*.props        text eol=crlf

# Binaries: never touch
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.ico binary
