# Normalise line endings for a Windows-native C project.
* text=auto

# Source and build/config files stay CRLF (edited and built on Windows).
*.c          text eol=crlf
*.h          text eol=crlf
*.bat        text eol=crlf
*.sln        text eol=crlf
*.vcxproj    text eol=crlf
*.filters    text eol=crlf
*.props      text eol=crlf

# Docs: let git normalise.
*.md         text

# Binaries — never touch.
*.exe        binary
*.dll        binary
*.lib        binary
*.pdb        binary
*.ico        binary
